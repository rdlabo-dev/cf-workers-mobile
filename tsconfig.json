{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "cf-workers-native/shared/contracts": ["./src/shared/contracts/index.ts"],
      "cf-workers-native/shared/contracts/testing": [
        "./src/shared/contracts/testing.ts"
      ]
    }
  },
  "include": ["src", "tests", "*.ts"]
}
