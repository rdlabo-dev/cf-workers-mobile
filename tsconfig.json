{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@rdlabo/workers-capacitor/shared/contracts": ["./src/shared/contracts/index.ts"],
      "@rdlabo/workers-capacitor/shared/contracts/testing": ["./src/shared/contracts/testing.ts"]
    }
  },
  "include": ["src", "tests", "*.ts"]
}
