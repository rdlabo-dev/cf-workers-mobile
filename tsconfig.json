{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@rdlabo/workers-capacitor/features": ["./src/features/index.ts"],
      "@rdlabo/workers-capacitor/testing": ["./src/features/testing.ts"]
    }
  },
  "include": ["src", "tests", "*.ts"]
}
