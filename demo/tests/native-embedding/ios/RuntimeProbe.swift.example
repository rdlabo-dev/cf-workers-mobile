import UIKit
import SwiftUI
import Capacitor
import WorkersIOS
import Consumer
import WebKit

@MainActor func waitForText(_ expected: String, in page: WKWebView) async throws {
 for _ in 0..<100 {
  let value = try? await page.evaluateJavaScript("document.body.innerText")
  if (value as? String)?.contains(expected) == true { return }
  try await Task.sleep(nanoseconds: 100_000_000)
 }
 throw URLError(.timedOut)
}
@MainActor func waitForWorkerHome(in controller: WorkersViewController) async throws -> (CAPBridgeViewController, WKWebView) {
 for _ in 0..<200 {
  if let runtime = controller.children.first as? CAPBridgeViewController,
     let document = runtime.children.first as? CAPBridgeViewController,
     let page = document.webView {
   let value = try? await page.evaluateJavaScript("document.body.innerText")
   if (value as? String)?.contains("Worker Home") == true { return (runtime, page) }
  }
  try await Task.sleep(nanoseconds: 100_000_000)
 }
 throw URLError(.timedOut)
}

@MainActor func waitForDismantle(_ controller: WorkersViewController) async throws {
 for _ in 0..<100 {
  if controller.children.isEmpty { return }
  try await Task.sleep(nanoseconds: 100_000_000)
 }
 throw URLError(.timedOut)
}

// Only a not-yet-ready host may time out while evaluating JavaScript disposal.
// close() still must finish native cleanup before reporting that error.
@MainActor func closeUnreadyHost(_ controller: WorkersViewController, label: String) async {
 do { try await controller.close() }
 catch {
  let failure = error as NSError
  assert(failure.domain == NSURLErrorDomain && failure.code == URLError.timedOut.rawValue,
         "Unexpected unready disposal error: \(failure)")
  print("SDK_UNREADY_DISPOSAL_TIMEOUT", label, failure.domain, failure.code)
 }
 assert(controller.children.isEmpty, "Native cleanup must finish even when JavaScript disposal times out")
}
@objc class AppDelegate: UIResponder, UIApplicationDelegate {}
@objc(SceneDelegate) class SceneDelegate: UIResponder, UIWindowSceneDelegate {
 var window: UIWindow?
 func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options connectionOptions: UIScene.ConnectionOptions) {
  print("SDK_SCENE_STARTED")
  fflush(stdout)
  let window = UIWindow(windowScene: scene as! UIWindowScene)
  let host = UIViewController()
  let child = try! makeEmbeddedController()
  host.addChild(child); child.view.frame = CGRect(x:20,y:100,width:350,height:600)
  host.view.addSubview(child.view); child.didMove(toParent: host)
  window.rootViewController = host; window.makeKeyAndVisible(); self.window = window
  if CommandLine.arguments.contains("broken-entry") {
   let shownAt = Date()
   var closedNotifications = 0
   var hiddenNotifications = 0
   let manuallyClosed = try! makeEmbeddedController()
   manuallyClosed.onStartupError = { _ in closedNotifications += 1 }
   host.addChild(manuallyClosed); host.view.addSubview(manuallyClosed.view); manuallyClosed.didMove(toParent: host)
   let hidden = try! makeEmbeddedController()
   hidden.onStartupError = { _ in hiddenNotifications += 1 }
   _ = hidden.view
   let closed = Task { @MainActor in await closeUnreadyHost(manuallyClosed, label: "manual") }
   child.onStartupError = { message in
    Task { @MainActor in
     await closed.value
     assert(message.contains("30 seconds") && Date().timeIntervalSince(shownAt) >= 29)
     assert(child.startupError != nil && child.children.isEmpty && window.rootViewController === host)
     assert(closedNotifications == 0 && manuallyClosed.children.isEmpty && manuallyClosed.startupError == nil)
     assert(hiddenNotifications == 0 && !hidden.children.isEmpty && hidden.startupError == nil)
     await closeUnreadyHost(hidden, label: "hidden")
     print("SDK_MANUAL_CLOSE_NO_LATE_ERROR", closedNotifications)
     print("SDK_HIDDEN_NO_DEADLINE", hiddenNotifications)
     print("SDK_BROKEN_ENTRY_CLEANED", child.children.count)
    }
   }
   return
  }
  if CommandLine.arguments.contains("startup-failure") {
   child.onStartupError = { message in
    assert(!message.isEmpty && child.startupError != nil)
    assert(child.children.isEmpty && window.rootViewController === host)
    print("SDK_STARTUP_FAILURE_CLEANED", child.children.count)
   }
   return
  }
  Task { @MainActor in
     let (runtime, page) = try! await waitForWorkerHome(in: child)
     print("SDK_DOCUMENT Worker Home")
     let hook = try! await runtime.webView!.evaluateJavaScript("typeof globalThis.__workersNativeDispose")
     assert(hook as? String == "function")
     print("SDK_HOOK function")
     // Deliberately outlive the startup deadline: ready must cancel it.
     try! await Task.sleep(nanoseconds: 35_000_000_000)
     assert(child.startupError == nil && !child.children.isEmpty && !runtime.children.isEmpty)
     assert(window.rootViewController === host)
     print("SDK_READY_SURVIVED_DEADLINE")
     _ = try! await page.evaluateJavaScript("document.querySelector('a').click()")
     try! await waitForText("Worker Next", in: page)
     print("SDK_NAVIGATION Worker Next")
     _ = try! await page.evaluateJavaScript("document.querySelector('form').requestSubmit()")
     try! await waitForText("Posted verified", in: page)
     print("SDK_POST Posted verified")
     assert(window.rootViewController === host)
     try! await child.close()
     try! await child.close()
     print("SDK_CLOSED CHILDREN",child.children.count,"RUNTIME_CHILDREN",runtime.children.count)
     assert(child.children.isEmpty && runtime.children.isEmpty)
     let reopened = try! makeEmbeddedController()
     window.rootViewController = UIHostingController(rootView: WorkersView(controller: reopened))
     _ = try! await waitForWorkerHome(in: reopened)
     print("SDK_REOPENED_SWIFTUI Worker Home")
     window.rootViewController = UIViewController()
     try! await waitForDismantle(reopened)
     assert(reopened.children.isEmpty)
     print("SDK_SWIFTUI_DISMANTLED", reopened.children.count)
  }
 }
}
UIApplicationMain(CommandLine.argc, CommandLine.unsafeArgv,nil,NSStringFromClass(AppDelegate.self))
