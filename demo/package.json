{
  "name": "capacitor-workers-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "sync": "cap sync",
    "ios": "cap run ios",
    "android": "cap run android",
    "test:browser": "npm run build && vite build --config tests/vite.express.config.ts && npm run build:validation && playwright test --config tests/playwright.config.ts",
    "test:workers": "vitest run --config tests/vitest.config.ts",
    "build:runtime": "vite build --config tests/fixtures/apps/runtime/vite.config.ts",
    "test:runtime": "npm run build:runtime && playwright test --config tests/playwright.runtime.config.ts",
    "preview:runtime": "vite preview --config tests/fixtures/apps/runtime/vite.config.ts --host 127.0.0.1 --port 4181 --strictPort",
    "test:runtime:dev": "playwright test --config tests/playwright.runtime-dev.config.ts",
    "build:tools": "node tests/scripts/build-tools.mjs",
    "test:build-tools": "vitest run --config tests/vitest.build.config.ts && npm run build:tools && playwright test --config tests/playwright.build-tools.config.ts",
    "build:validation": "vite build --config tests/validation/vite.config.ts",
    "test:native:prepare": "node tests/scripts/prepare-native.mjs",
    "build:native-documents": "node tests/scripts/build-native-documents.mjs",
    "test:documents": "npm run build:native-documents && playwright test --config tests/playwright.documents.config.ts",
    "build:rendering": "vite build --config rendering/vite.config.ts",
    "test:native:package:prepare": "node tests/scripts/prepare-native-package.mjs",
    "test:native:package": "node tests/scripts/run-native-package.mjs",
    "test:upstream:workerd": "vitest run --config tests/vitest.upstream.config.ts",
    "test:upstream:prepare": "node tests/scripts/prepare-upstream.mjs",
    "test:upstream": "node tests/scripts/run-upstream-native.mjs",
    "test:upstream:browser": "vite build --config tests/upstream/hono-jsx-ssr/browser/vite.config.ts && playwright test --config tests/playwright.upstream.config.ts",
    "build:native-network": "node tests/scripts/build-native-network.mjs",
    "test:native:network:server": "node tests/scripts/network-server.mjs",
    "test:native:network": "node tests/scripts/run-native-network.mjs",
    "test:workers:tls": "vitest run --config tests/vitest.tls.config.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@rdlabo/capacitor-workers": "file:..",
    "express": "^5.3.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "cf": "^1.0.0-beta.17",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261012.0-beta",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
